# Flask
SECRET_KEY=change-me

# Summaries: LLM_PROVIDER is gemini (default) or grok
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_API_KEY=
GROK_MODEL=grok-4.3
# Characters of extracted text sent for summarizing
# SUMMARY_MAX_CHARS=200000
# Seconds to wait for each LLM request
# SUMMARY_TIMEOUT_SECONDS=90
# Return placeholder summaries when the LLM call fails. Defaults to true locally
# and false on Lambda, where a failed summary marks the job failed.
# ALLOW_MOCK_SUMMARY=true

# Webhooks
# Required to send webhooks. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
# Optional HTTPS URL used when an upload does not provide one
DEFAULT_WEBHOOK_URL=
# Local development only: allows http:// and private addresses
# WEBHOOK_ALLOW_PRIVATE_URLS=true
